{
  "expo": {
    "name": "IRONCLAD",
    "slug": "ironclad",
    "scheme": "ironclad",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lowkeylabib.ironclad",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Choose optional progress photos for your fitness journal."
      },
      "buildNumber": "2",
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "com.lowkeylabib.ironclad",
      "permissions": [
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ],
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#14213D"
      },
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "IRONCLAD needs access only when you choose a progress photo."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#14213D",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#14213D",
            "image": "./assets/splash-icon.png"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png",
    "backgroundColor": "#14213D"
  }
}
