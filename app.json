{
  "expo": {
    "name": "IRONCLAD",
    "slug": "ironclad",
    "scheme": "ironclad",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lowkeylabib.ironclad",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Choose optional progress photos for your fitness journal."
      },
      "buildNumber": "1",
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "com.lowkeylabib.ironclad",
      "permissions": [
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ],
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0D10"
      },
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "IRONCLAD needs access only when you choose a progress photo."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png",
    "backgroundColor": "#0B0D10"
  }
}
